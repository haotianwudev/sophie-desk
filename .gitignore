# Obsidian local state — keep shared config, drop per-machine noise
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# supervisor scratch
desk-status.json.tmp
*.log

# never publish these
notes/private/
papers/**/*.pdf

# local SQLite paper index, rebuilt from papers/ markdown by
# sophie-pipeline/paper-index/build_index.py -- disposable, not source of truth
papers/paper-index/

# personal Google Drive doc index/cache -- titles + doc_ids + cached content
# are personal research notes, not for a public repo. See gdocs-index-sync task.
gdocs/

# supervisor local state (status.json IS committed on purpose)
supervisor/supervisor.pid
supervisor/supervisor.log

# python cache
__pycache__/
*.pyc

# scratch/working files agents may leave mid-task (e.g. extracted PDF text,
# a one-off consolidation script) -- never intentional output, just don't
# let them get swept into a commit. Any extension, not just .txt/.md --
# missed .py/.json once already.
scratch_*
